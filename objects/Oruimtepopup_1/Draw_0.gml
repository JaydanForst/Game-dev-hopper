  draw_self();


    draw_set_halign(fa_center);
    draw_set_valign(fa_middle);
    draw_set_color(c_black);
    draw_set_font(Ruimte_font);


    draw_text(room_width/2.6, room_height/3.3,
        "Zo! Kijk eens aan, je hebt een glitch gevonden! zo te zien is");
    draw_text(room_width/2.6, room_height/3,
        "het een invisible wall. Dat betekent dat er een bug verstopt");
	 draw_text(room_width/2.6, room_height/2.75,
        "is in dit level. Kijk rond en probeer hem te vinden. Zodra dat");
	 draw_text(room_width/2.6, room_height/2.5,
        "je is gelukt, klik erop met de linkermuis knop. Veel succes!");
	

