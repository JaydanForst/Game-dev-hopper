  draw_self();


    draw_set_halign(fa_center);
    draw_set_valign(fa_middle);
    draw_set_color(c_black);
    draw_set_font(Ruimte_font);


    draw_text(room_width/2.6, room_height/3.3,
        "Correct! De programmeur is inderdaad de persoon die je moet");
    draw_text(room_width/2.6, room_height/3,
        "contacteren wanneer je een bug hebt gevonden. De andere 2 rollen");
	 draw_text(room_width/2.6, room_height/2.75,
        "kunnen hiervoor ook gecontacteerd worden, maar die beschikken niet");
	 draw_text(room_width/2.6, room_height/2.5,
        "de kennis om dit probleem op te lossen. Knap gedaan! Klik nu op de ");
	 draw_text(room_width/2.6, room_height/2.28,
        "UFO knop onder je, zodat het level gefixt kan worden en je het uit ");
	 draw_text(room_width/2.6, room_height/2.05,
        "kan spelen! ");
	draw_text(room_width/2.6, room_height/1.88,
        "WAARSCHUWING: Het level dat u gaat spelen is extreem moeilijk! ");
	draw_text(room_width/2.6, room_height/1.73,
        "Gelieve niet boos worden of de laptops breken. Alvast bedankt!!!");
	

